---
import Plate from './Plate.astro';
import { asset, type Day } from '../lib/wall';
interface Props { day: Day; editMode?: boolean }
const { day, editMode = false } = Astro.props;
const meta = day.status === 'pending'
  ? '布展中'
  : [day.place, day.counts.photo && `${day.counts.photo} 張照片`, day.counts.video && `${day.counts.video} 支短片`].filter(Boolean).join(' · ');
---
<div class="day" id={`day-${day.n}`} data-date={day.date} data-place={[day.city, day.place].filter(Boolean).join(' · ')}>
  {day.backdrop.length > 0 && (
    <div class="backdrops" aria-hidden="true">{day.backdrop.map((b) => (
      <img src={asset(b.src)} alt="" loading="lazy" decoding="async" style={`left:${b.x}%;top:${b.y}%;height:${b.h}%;--r:${b.r}deg`} />
    ))}</div>
  )}
  <div class="dh">
    <span class="dnum">{day.label}</span><span class="dwd">{day.weekday}</span>
    {editMode && day.status === 'live' && (
      <button type="button" class="btn-add-ema" data-day={day.date}>掛一塊繪馬</button>
    )}
  </div>
  <div class="dmeta">DAY {day.n} · {meta}</div>
  <div class="cols">
    {day.status === 'pending' ? (
      <div class="bay"><div><strong>展區布置中</strong>{day.note}</div></div>
    ) : day.columns.map((col) => (
      <div class:list={['col', { unsorted: col.unsorted }]} style={`--colw:${col.width}px`}>
        {col.items.map((it) => {
          if (it.kind === 'text') return (
            <div class="it it-text">
              <div class:list={['tm', { unk: !it.time }]}>{it.time ?? '時刻待補'}</div>
              <h4>{it.title}</h4><p>{it.body}</p>
            </div>
          );
          // 心得欄位是給 Viking 的提示：只在本機預覽顯示，公開版不出現。填好的心得改用 text 文字卡
          if (it.kind === 'slot') return import.meta.env.DEV ? <div class="it it-slot">{it.text}<small>心得欄位</small></div> : null;
          const e = it.exhibit;
          return (
            <button class="it it-media" data-i={it.index} data-exhibit-id={e.id} aria-label={`查看展品 ${e.title || e.id}`}>
              <Plate exhibit={e} />
              <span class="cap"><b><span class="g">{e.type === 'video' ? '▶' : '■'}</span> {e.id}</b>{e.title ? e.title : <span class="untitled">（待命名）</span>}</span>
            </button>
          );
        })}
      </div>
    ))}
  </div>
  {/* 趣事帶：牆面模式絕對定位在屋簷上；閱讀模式排在當天最後 */}
  {day.story && <img class="story" src={asset(day.story.src)} alt="" aria-hidden="true" loading="lazy" decoding="async" style={`--x:${day.story.x}%`} />}
</div>
