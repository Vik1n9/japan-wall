// 後台 Worker（kura 網域）：npm run deploy:back
// 前置（Viking 在 Cloudflare 做一次）：
//   1. npx wrangler@4 d1 create osaka2026 → 把真實 database_id 填到下面
//   2. npm run db:setup:remote（建表）
//   3. npm run admin:create -- <username>（建第一個管理員，會印出初始密碼）
// 本機開發：npm run db:setup:local → npm run admin:create -- <username> --local → npm run dev:api
{
  "name": "osaka2026-kura",
  "main": "worker/back.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "osaka2026",
      // TODO: wrangler d1 create osaka2026 後填入真實 ID
      "database_id": "b517067c-48fa-4d82-b267-0db4be6d1f19"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      // TODO: wrangler r2 bucket create osaka2026-uploads（本機 dev 自動模擬）
      "bucket_name": "osaka2026-uploads"
    }
  ],
  "vars": {
    // http://kura… 是给 wrangler dev：本機同源請求的 Origin 會被改寫成 http 版 route hostname
    "ALLOWED_ORIGINS": "https://kura.osaka2026.voriens.dev,http://kura.osaka2026.voriens.dev,http://localhost:8787,http://localhost:4321",
    // 牆上的展覽日（上傳照片要指定掛在哪一天）
    "DAYS": "2026-10-05,2026-10-06,2026-10-07,2026-10-08,2026-10-09"
  },
  // 每日排程清理：過期 session 與老的登入失敗紀錄（UTC 19:17＝台灣凌晨 3:17）
  "triggers": { "crons": ["17 19 * * *"] },
  // 只有這個網址開得到後台；不掛 workers.dev
  "routes": [{ "pattern": "kura.osaka2026.voriens.dev", "custom_domain": true }],
  "workers_dev": false
}
