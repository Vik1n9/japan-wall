// 前台 Worker（純展示）：npm run deploy
// 只有 /api/*、/edit*、/admin* 進 Worker 回 404，其餘直接由靜態資源回應、不計費。
// 這個部署裡沒有任何登入/後台程式碼——後台在 wrangler.back.jsonc（kura 網域）。
{
  "name": "osaka2026",
  "main": "worker/front.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/edit", "/edit/*", "/admin", "/admin/*"]
  },
  // 階段 6：前台動態渲染需要的唯讀綁定（與後台同一個 D1/R2）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "osaka2026",
      // TODO: wrangler d1 create osaka2026 後填入真實 ID（與 wrangler.back.jsonc 相同）
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "osaka2026-uploads"
    }
  ],
  // 綁定自訂網域；不另外開 workers.dev 網址
  "routes": [{ "pattern": "osaka2026.voriens.dev", "custom_domain": true }],
  "workers_dev": false
}
