// Cloudflare Workers（靜態資源＋留言與繪馬 API）：npm run deploy
{
  "name": "osaka2026",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // 只有 /api/* 進 Worker，其餘路徑直接由靜態資源回應、不計費
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "osaka2026-notes",
      "database_id": "dc0e8bef-117d-436a-8005-b12f3cb109d2"
    }
  ],
  "vars": {
    "EDITORS": "viking@example.com,friend1@example.com",
    "ALLOWED_ORIGINS": "https://osaka2026.voriens.dev"
  },
  // 綁定自訂網域；不另外開 workers.dev 網址
  "routes": [{ "pattern": "osaka2026.voriens.dev", "custom_domain": true }],
  "workers_dev": false
}
