// Cloudflare Workers（純靜態資源）：npm run deploy
// 舊的 /api/* 投稿後台（Cloudflare Access 收稿制）已於 2026-10-17 拆除；
// 新版後台（帳號密碼＋動態公開，前後台雙網域）見 README 待辦。
{
  "name": "osaka2026",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  },
  // 綁定自訂網域；不另外開 workers.dev 網址
  "routes": [{ "pattern": "osaka2026.voriens.dev", "custom_domain": true }],
  "workers_dev": false
}
